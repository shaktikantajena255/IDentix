# IDentix Frontend — Environment Variables
# Copy this file to .env.local for local development overrides.
# Set these in Vercel Dashboard → Project Settings → Environment Variables for production.

# Backend API base URL.
# DEVELOPMENT: Leave empty — Vite's dev proxy handles /api/* → http://localhost:8000
# PRODUCTION:  Set to your deployed backend URL (no trailing slash)
# Example: https://identix-backend.railway.app
VITE_API_URL=
